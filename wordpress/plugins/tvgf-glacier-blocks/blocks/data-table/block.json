{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tvgf/data-table",
	"title": "TVGF - Data Table",
	"category": "text",
	"icon": "editor-table",
	"description": "A labelled data table — a header plus a list of label/value rows (e.g. key regional figures).",
	"attributes": {
		"header": { "type": "string", "default": "" },
		"rows": { "type": "array", "default": [], "items": { "type": "object" } }
	},
	"supports": { "html": false },
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css"
}
