# WordPress GraphQL endpoint (WPGraphQL plugin), e.g. https://cms.thevoiceofglaciers.org/graphql
WORDPRESS_GRAPHQL_URL=

# Shared secret — must match TVGF_REVALIDATE_SECRET in WordPress's wp-config.php.
# Lets the WP webhook tell this app to refresh a dialogue without a redeploy.
WORDPRESS_REVALIDATE_SECRET=

# Shared secret — must match TVGF_PREVIEW_SECRET in WordPress's wp-config.php.
# Powers the "Preview" button on an unpublished dialogue in WP admin.
WORDPRESS_PREVIEW_SECRET=

# WordPress Application Password (WP Admin > Users > Profile > Application
# Passwords), used server-side only to fetch draft/unpublished content for
# preview, and by scripts/migrate-dialogues.mjs to create/upload content.
WORDPRESS_PREVIEW_APP_USER=
WORDPRESS_PREVIEW_APP_PASSWORD=

# Base site URL (no trailing slash), used only by scripts/migrate-dialogues.mjs
WORDPRESS_SITE_URL=
